#!/bin/sh
set -eu

command=${1:-}
valid_project() {
  case "$1" in ''|[!a-z0-9]*|*[!a-z0-9_-]*) return 1 ;; esac
  [ "${#1}" -le 63 ]
}
usage_error() { echo "Usage: $1" >&2; exit 2; }
case "$command" in
  help)
    [ "$#" -eq 1 ] || usage_error './dev help'
    cat <<'HELP'
Usage: ./dev <command>
  up, down, status, logs, credentials
  secure:up <explicit-compose-project-name> (local HTTPS)
  benchmark:prepare <csi-benchmark-name> <same-name-to-approve>
  benchmark:run <csi-benchmark-name> smoke|compare|reference|hpa <comma-separated-login-ids>
  benchmark:down <csi-benchmark-name> <same-name-to-approve>
  benchmark:metrics <csi-benchmark-name> warm|load|overload|recovery <seconds>
  recovery:backup <csi-benchmark-or-recovery-project> <absolute-private-file>
  recovery:restore <absolute-private-file> <new-csi-recovery-project> <same-name-to-approve>
  k8s:up <csi-benchmark-project> <csi-hardening-cluster>
  k8s:demo <csi-benchmark-project> <csi-hardening-cluster> smoke|compare|reference|hpa <comma-separated-login-ids>
  k8s:down <csi-benchmark-project> <csi-hardening-cluster> <same-cluster-to-approve>
  demo <run-id> --approve
  test:docker <api|web|python|browser|all>
  check, test, build, format
  provision, fixture, data:generate, data:validate, data:import
  data:demo, data:benchmark, simulate:provision, simulate
Set CSI_WEB_PORT for a different loopback web port.
Set CSI_COMPOSE_PROJECT for an isolated Compose project.
HELP
    ;;
  up)
    [ "$#" -eq 1 ] || usage_error './dev up'
    sh tools/dev/local.sh up
    ;;
  secure:up)
    [ "$#" -eq 2 ] && valid_project "$2" || usage_error './dev secure:up <explicit-compose-project-name>'
    CSI_COMPOSE_PROJECT="$2" sh tools/dev/local.sh secure:up
    ;;
  benchmark:prepare|benchmark:run|benchmark:down|benchmark:metrics)
    action=${command#benchmark:}
    shift
    sh tools/benchmark/local.sh "$action" "$@"
    ;;
  recovery:backup|recovery:restore)
    action=${command#recovery:}
    shift
    sh tools/recovery/local.sh "$action" "$@"
    ;;
  k8s:up|k8s:demo|k8s:down)
    action=${command#k8s:}
    shift
    sh tools/k8s/local.sh "$action" "$@"
    ;;
  provision)
    if [ "$#" -ne 2 ] || ! valid_project "$2" || [ ! -f .env ]; then
      echo 'Usage: ./dev provision <explicit-compose-project-name> (requires .env)' >&2
      exit 2
    fi
    docker compose -p "$2" up -d --wait db
    docker compose -p "$2" run --rm db-provision
    ;;
  fixture)
    if [ "$#" -ne 2 ] || ! valid_project "$2" || [ "${CSI_ISOLATED_TEST_DB:-}" != 1 ] || [ ! -f .env ]; then
      echo 'Usage: CSI_ISOLATED_TEST_DB=1 ./dev fixture <explicit-isolated-compose-project-name>' >&2
      exit 2
    fi
    docker compose -p "$2" up -d --wait db
    docker compose -p "$2" run --rm db-provision
    docker compose -p "$2" exec -T db sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" psql -U customer_insights -d customer_insights -v ON_ERROR_STOP=1' < tools/db/test-fixture.sql
    ;;
  data:demo|data:benchmark)
    profile=${command#data:}
    output="generated-data/$profile"
    if [ "$#" -ne 3 ] || ! valid_project "$2" || [ "$2" != "$3" ]; then
      echo "Usage: ./dev $command <explicit-compose-project-name> <same-name-to-approve-target>" >&2
      exit 2
    fi
    if [ ! -e "$output" ]; then
      (cd tools/data-generator && uv run --locked python -m csi_data generate "$profile" "../../$output")
    fi
    (cd tools/data-generator && uv run --locked python -m csi_data validate "../../$output")
    (cd tools/data-generator && uv run --locked python -m csi_data import "../../$output" --project "$2" --approve-target "$3")
    ;;
  data:generate)
    [ "$#" -eq 3 ] || { echo 'Usage: ./dev data:generate <demo|benchmark> <output-directory>' >&2; exit 2; }
    (cd tools/data-generator && uv run --locked python -m csi_data generate "$2" "../../$3")
    ;;
  data:validate)
    [ "$#" -eq 2 ] || { echo 'Usage: ./dev data:validate <output-directory>' >&2; exit 2; }
    (cd tools/data-generator && uv run --locked python -m csi_data validate "../../$2")
    ;;
  data:import)
    [ "$#" -eq 4 ] || { echo 'Usage: ./dev data:import <output-directory> <compose-project-name> <same-name-to-approve-target>' >&2; exit 2; }
    valid_project "$3" && [ "$3" = "$4" ] || { echo 'Explicit target approval must match the Compose project' >&2; exit 2; }
    dataset_path=$(cd "$2" 2>/dev/null && pwd -P) || { echo 'Invalid dataset directory' >&2; exit 2; }
    (cd tools/data-generator && uv run --locked python -m csi_data import "$dataset_path" --project "$3" --approve-target "$4")
    ;;
  simulate:provision)
    [ "$#" -eq 4 ] || [ "$#" -eq 5 ] || usage_error './dev simulate:provision <project> <project> --fixture|--dataset <directory>'
    valid_project "$2" && [ "$2" = "$3" ] || usage_error './dev simulate:provision <project> <project> --fixture|--dataset <directory>'
    if [ "$#" -eq 4 ]; then
      [ "$4" = --fixture ] || usage_error './dev simulate:provision <project> <project> --fixture'
    else
      [ "$4" = --dataset ] && [ -n "$5" ] || usage_error './dev simulate:provision <project> <project> --dataset <directory>'
    fi
    shift
    (cd tools/data-generator && uv run --locked python -m csi_data.simulator_approval "$@")
    ;;
  simulate)
    [ "$#" -ge 4 ] && valid_project "$2" && [ "$2" = "$3" ] || usage_error './dev simulate <project> <project> pending|post|cancel ...'
    case "$4" in
      pending) [ "$#" -eq 10 ] || usage_error './dev simulate <project> <project> pending <key> <account> <merchant> <amount> <time> <description>' ;;
      post) [ "$#" -eq 8 ] || usage_error './dev simulate <project> <project> post <key> <authorization> <amount> <time>' ;;
      cancel) [ "$#" -eq 7 ] || usage_error './dev simulate <project> <project> cancel <key> <authorization> <time>' ;;
      *) usage_error './dev simulate <project> <project> pending|post|cancel ...' ;;
    esac
    shift
    python3 tools/simulator/cli.py "$@"
    ;;
  down|status|logs|credentials)
    [ "$#" -eq 1 ] || usage_error "./dev $command"
    sh tools/dev/local.sh "$@"
    ;;
  demo)
    [ "$#" -eq 3 ] && [ "$3" = --approve ] || usage_error './dev demo <run-id> --approve'
    case "$2" in ''|*[!a-z0-9-]*) usage_error './dev demo <lowercase-run-id> --approve' ;; esac
    [ "${#2}" -le 30 ] || usage_error './dev demo <lowercase-run-id> --approve'
    sh tools/dev/local.sh "$@"
    ;;
  test:docker)
    [ "$#" -eq 2 ] || usage_error './dev test:docker <api|web|python|browser|all>'
    case "$2" in api|web|python|browser|all) ;; *) usage_error './dev test:docker <api|web|python|browser|all>' ;; esac
    sh tools/dev/test-docker.sh "$2"
    ;;
  build)
    [ "$#" -eq 1 ] || usage_error './dev build'
    (cd apps/api && ./gradlew bootJar)
    pnpm build
    ;;
  check)
    [ "$#" -eq 1 ] || usage_error './dev check'
    (cd apps/api && ./gradlew spotlessCheck)
    (cd apps/api && ./gradlew test)
    pnpm --filter web api:check
    pnpm check
    pnpm test
    (cd tools/data-generator && uv run --locked ruff check . ../simulator && uv run --locked ruff format --check . ../simulator && uv run --locked pytest -q)
    docker compose --env-file .env.example config --quiet
    ;;
  format)
    [ "$#" -eq 1 ] || usage_error './dev format'
    (cd apps/api && ./gradlew spotlessApply)
    pnpm --filter web exec prettier --write .
    (cd tools/data-generator && uv run --locked ruff format . ../simulator)
    ;;
  test)
    [ "$#" -eq 1 ] || usage_error './dev test'
    (cd apps/api && ./gradlew clean test)
    python3 - <<'PY'
from pathlib import Path
from xml.etree import ElementTree

reports = list(Path('apps/api/build/test-results/test').glob('TEST-*.xml'))
counts = [ElementTree.parse(report).getroot().attrib for report in reports]
executed = sum(int(c['tests']) - int(c.get('skipped', 0)) for c in counts)
assert executed > 0 and all(int(c.get('failures', 0)) == 0 and int(c.get('errors', 0)) == 0 for c in counts), 'Java tests missing, skipped or failed'
print(f'Java tests executed: {executed}')
PY
    pnpm test
    (cd tools/data-generator && uv run --locked pytest -q)
    ;;
  *)
    echo 'Run ./dev help for available commands.' >&2
    exit 2
    ;;
esac
